# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
nul

# logs and dev scratch files
*.log
tmp-*
.tmp-*
lint-output.txt

# local tooling artifacts (not part of the app)
.playwright-mcp/
qa-e2e-artifacts/
qa-screenshots/
.codex-github-*/
.gemini/

# deploy archives (large, environment-specific)
naija-deploy*.tar.gz

# local Postgres backup dumps
/backups/
